APP_NAME="Page vệ tinh D&T"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

# Domain của trang quản trị (Filament), vào tại https://<ADMIN_DOMAIN>/admin
ADMIN_DOMAIN=admin.trangthietbi.vn

# Mautic REST API để đồng bộ lead (để trống = không đồng bộ)
MAUTIC_URL=
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
# Email nhận cảnh báo kỹ thuật (lead không vào được Mautic...)
DEV_ALERT_EMAIL=

# Cloudflare Turnstile cho form yêu cầu báo giá (để trống = tắt).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true = bắt buộc Turnstile (chặt hơn, nhưng khách tắt JavaScript không gửi được form)
TURNSTILE_REQUIRED=false

# Ép https cho mọi URL công khai. Production/staging: true. Local http thuần: false.
FORCE_HTTPS=true
# Proxy đứng trước app (Nginx/Cloudflare) được tin để đọc X-Forwarded-Proto/For.
# Ví dụ: 127.0.0.1 hoặc danh sách IP, cách nhau dấu phẩy. Để trống = không tin proxy nào.
TRUSTED_PROXIES=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=page_ve_tinh
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: redis (+ chạy `php artisan queue:work --tries=5`). Local không có Redis thì để database.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
